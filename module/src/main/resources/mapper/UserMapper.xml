<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.yuhanpeng.musiccard.module.mapper.UserMapper">
    <insert id="insert"
            useGeneratedKeys="true"
            keyProperty="id">
        insert into user
        <trim prefix="("
              suffix=")"
              suffixOverrides=",">
            <if test="user.phone!=null and user.phone!=''">
                phone,
            </if>
            <if test="user.password!=null and user.password!=''">
                password,
            </if>
            <if test="user.salt!=null and user.salt!=''">
                salt,
            </if>
            <if test="user.name!=null and user.name!=''">
                name,
            </if>
            <if test="user.avatar!=null and user.avatar!=''">
                avatar,
            </if>
            <if test="user.createTime!=null">
                create_time,
            </if>
            <if test="user.updateTime!=null">
                update_time,
            </if>
            <if test="user.isDeleted!=null">
                is_deleted,
            </if>
        </trim>
        <trim prefix="values("
              suffix=")"
              suffixOverrides=",">
            <if test="user.phone!=null and user.phone!=''">
                #{user.phone},
            </if>
            <if test="user.password!=null and user.password!=''">
                #{user.password},
            </if>
            <if test="user.salt!=null and user.salt!=''">
                #{user.salt},
            </if>
            <if test="user.name!=null and user.name!=''">
                #{user.name},
            </if>
            <if test="user.avatar!=null and user.avatar!=''">
                #{user.avatar},
            </if>
            <if test="user.createTime!=null">
                #{user.createTime},
            </if>
            <if test="user.updateTime!=null">
                #{user.updateTime},
            </if>
            <if test="user.isDeleted!=null">
                #{user.isDeleted},
            </if>
        </trim>
    </insert>

    <update id="update">
        update user
        <set>
            <if test="user.phone!=null and user.phone!=''">
                phone=#{user.phone},
            </if>
            <if test="user.password!=null and user.password!=''">
                password=#{user.password},
            </if>
            <if test="user.salt!=null and user.salt!=''">
                salt=#{user.salt},
            </if>
            <if test="user.name!=null and user.name!=''">
                name=#{user.name},
            </if>
            <if test="user.avatar!=null and user.avatar!=''">
                avatar=#{user.avatar},
            </if>
            <if test="user.createTime!=null">
                create_time=#{user.createTime},
            </if>
            <if test="user.updateTime!=null">
                update_time=#{user.updateTime},
            </if>
            <if test="user.isDeleted!=null">
                is_deleted=#{user.isDeleted},
            </if>
        </set>
        where id=#{user.id}
    </update>

    <update id="delete">
        update user
        set is_deleted  = 1,
            update_time = #{time}
        where id = #{id}
          and is_deleted = 0
    </update>
</mapper>